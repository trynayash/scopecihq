{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/scopeci run build",
  "outputDirectory": "artifacts/scopeci/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "artifacts/api-server/src/**",
        "lib/**"
      ]
    }
  }
}