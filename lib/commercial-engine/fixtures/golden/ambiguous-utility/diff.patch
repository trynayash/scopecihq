+export function formatRowsAsCsv(headers: string[], rows: (string | number)[][]): string {
+  const headerLine = headers.join(',');
+  const bodyLines = rows.map((r) => r.join(','));
+  return [headerLine, ...bodyLines].join('\n');
+}
