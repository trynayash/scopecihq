# Postgres connection string. With Supabase: Project → Connect → ORMs / Session
# pooler, then paste the URI here and replace [YOUR-PASSWORD].
#
# Use the SESSION pooler (port 5432) or the direct connection. The TRANSACTION
# pooler (port 6543) drops prepared statements between queries, which breaks
# the node-postgres driver this project uses.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# TLS is enabled automatically for any non-local host. Append ?sslmode=verify-full
# and set DATABASE_CA_CERT to verify the certificate chain as well.
DATABASE_URL=

# Optional. Max pooled connections held by the API server (default 10).
# DATABASE_POOL_MAX=10

# Optional. PEM contents, only read when sslmode=verify-full or verify-ca.
# DATABASE_CA_CERT=

# Shared secret for the /admin/waitlist page. Set this to a long random string.
# The admin API returns 401 without a valid key.
ADMIN_SECRET=

# Optional. How many proxies sit in front of the server (default 1, which is
# right for Render and Vercel). Rate limiting keys on the client address the
# outermost trusted proxy reports, so raise this only if you add another
# proxy, such as a CDN in front of Render.
# TRUST_PROXY_HOPS=1

# ===================================================================
# ScopeCI Domain Architecture & Application URLs
# ===================================================================
# The final custom domain (scopeci.<tld>) has NOT been purchased yet.
# Do NOT hardcode .dev, .com, or .in — use env vars at deploy time.
#
# Future architecture (when domain is purchased):
#   Marketing:   https://scopeci.<domain>
#   Application: https://app.scopeci.<domain>
#   API:         https://api.scopeci.<domain>
#
# Current temporary public deployment:
NEXT_PUBLIC_MARKETING_URL=https://scopeci.onrender.com

# Authenticated ScopeCI product application URL (not publicly launched yet)
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Used only by the public demo to read public pull requests.
# A token with no scopes is enough; without one GitHub allows 60 lookups an
# hour for the whole server.
# GITHUB_TOKEN=

# ===================================================================
# GitHub App: sign-in and pull request checks (docs/github-app.md)
# ===================================================================
GITHUB_APP_ID=
# The App's slug, from https://github.com/apps/<slug>
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The .pem contents: real newlines, \n escapes, or the file base64-encoded
GITHUB_APP_PRIVATE_KEY=
# Encrypts stored GitHub user tokens; sign-in stays off in production without it
GITHUB_TOKEN_ENCRYPTION_KEY=
# Production mounts the Linear routes only when this is true (connect, callback
# and sync still answer 503 until a real Linear token exchange is built)
# ENABLE_INTEGRATION_ROUTES=true
# For GitHub Enterprise Server
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# ===================================================================
# Linear Integration Configuration (Phase 3)
# ===================================================================
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/api/integrations/linear/callback

# AES-256-GCM Token Encryption (Phase 3 Safeguard 1)
# 32-byte secret passphrase or hex string with key rotation support
LINEAR_TOKEN_ENCRYPTION_KEY=
# LINEAR_TOKEN_ENCRYPTION_KEY_V1=
# LINEAR_TOKEN_ENCRYPTION_KEY_V2=

