# Postgres connection string. With Supabase: Project → Connect → ORMs / Session
# pooler, then paste the URI here and replace [YOUR-PASSWORD].
#
# Use the SESSION pooler (port 5432) or the direct connection. The TRANSACTION
# pooler (port 6543) drops prepared statements between queries, which breaks
# the node-postgres driver this project uses.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# TLS is enabled automatically for any non-local host. Append ?sslmode=verify-full
# and set DATABASE_CA_CERT to verify the certificate chain as well.
DATABASE_URL=

# Optional. Max pooled connections held by the API server (default 10).
# DATABASE_POOL_MAX=10

# Optional. PEM contents, only read when sslmode=verify-full or verify-ca.
# DATABASE_CA_CERT=
