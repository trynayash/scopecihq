{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "simulate": "node node_modules/.pnpm/tsx@4.23.4/node_modules/tsx/dist/cli.mjs lib/commercial-engine/src/simulator.ts",
    "db:seed": "node --env-file-if-exists=.env node_modules/.pnpm/tsx@4.23.4/node_modules/tsx/dist/cli.mjs lib/db/src/seed.ts",
    "db:test": "node --env-file-if-exists=.env node_modules/.pnpm/tsx@4.23.4/node_modules/tsx/dist/cli.mjs lib/db/src/tests/provenance.test.ts",
    "test:github": "node --env-file-if-exists=.env node_modules/.pnpm/tsx@4.23.4/node_modules/tsx/dist/cli.mjs artifacts/api-server/src/tests/github-app.test.ts",
    "test:linear": "node --env-file-if-exists=.env node_modules/.pnpm/tsx@4.23.4/node_modules/tsx/dist/cli.mjs artifacts/api-server/src/tests/linear-integration.test.ts",
    "test:security": "node --env-file-if-exists=.env node_modules/.pnpm/tsx@4.23.4/node_modules/tsx/dist/cli.mjs artifacts/api-server/src/tests/security-audit.test.ts",
    "replay:evaluation": "node --env-file-if-exists=.env node_modules/.pnpm/tsx@4.23.4/node_modules/tsx/dist/cli.mjs lib/commercial-engine/src/replay.ts",
    "test:phase4": "node --env-file-if-exists=.env node_modules/.pnpm/tsx@4.23.4/node_modules/tsx/dist/cli.mjs artifacts/api-server/src/tests/phase4-commercial-intelligence.test.ts",
    "test:launch": "node --env-file-if-exists=.env node_modules/.pnpm/tsx@4.23.4/node_modules/tsx/dist/cli.mjs artifacts/api-server/src/tests/public-launch-boundary.test.ts"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "fast-uri": "^3.1.6",
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.18",
      "qs": "^6.16.0"
    }
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
